# npm configuration for this repository.
#
# Two goals: (1) stop `npm install` from silently drifting away from
# package-lock.json, and (2) stop arbitrary install-time code execution by
# transitive dependencies.

# ---------------------------------------------------------------------------
# Lockfile fidelity
# ---------------------------------------------------------------------------
# Refuse to install when package.json and package-lock.json disagree, instead of
# quietly rewriting the lockfile. This is what makes `npm ci` in CI meaningful:
# without it, a local `npm install <pkg>` can leave the lockfile unsaved and the
# PR ships a manifest that no lockfile describes.
save-exact=true

# Always write a lockfile, and never fall back to a resolved-but-unlocked tree.
package-lock=true

# ---------------------------------------------------------------------------
# Install-time script execution
# ---------------------------------------------------------------------------
# The dependency tree contains exactly two packages with install scripts:
#   - fsevents      (macOS-only file watcher; optional on Linux/Windows CI)
#   - unrs-resolver (native binding used by eslint-import-resolver-typescript)
#
# unrs-resolver was checked explicitly: its native bindings are shipped as
# optionalDependencies (@unrs/resolver-binding-*), so npm installs the correct
# prebuilt binary for the platform WITHOUT running the postinstall. Verified by
# running `npm ci --ignore-scripts` in a scratch copy and then exercising
# ResolverFactory.sync() — resolution returns structured results, not a
# "binding not found" error. `npm run lint` therefore still works on CI.
#
# Any NEW install script appearing in the tree will now fail loudly rather than
# execute. If that happens, re-enable for that one package with
# `npm install --foreground-scripts` after reviewing it, and record the review.
ignore-scripts=true

# ---------------------------------------------------------------------------
# Registry / supply-chain hygiene
# ---------------------------------------------------------------------------
# HTTPS only. No private registry is configured, and this package is
# `private: true`, so there is nothing to publish and no name for an attacker to
# squat via dependency confusion. Explicit https:// also prevents a hijacked
# DNS entry or a malicious proxy from downgrading a fetch to plaintext.
registry=https://registry.npmjs.org/

# Fail the install on a HIGH-or-worse advisory rather than printing a warning.
# CI enforces this more precisely (see .github/workflows/ci.yml); this is the
# local-developer floor so a vulnerable install is visible before it is pushed.
audit-level=high

# `fund`/`update-notifier` are network calls during every install for no
# security or build benefit.
fund=false
update-notifier=false

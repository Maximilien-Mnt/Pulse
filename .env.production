# ─── Cloudflare Pages production environment (template) ─────────────────
# Copy this file to .env (gitignored, never commit) and replace placeholder
#
# For Cloudflare Pages: set the same real values in the dashboard at
#   Settings > Variables and Secrets > Production AND Preview
# The build log currently shows Build environment variables: (none found)
# which means Pages is not injecting dashboard vars into the container.
# This .env.production is a template — it will fail the placeholder check
# until real values are supplied by the dashboard or a local .env file.
# ─────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# CLOUDFLARE_TURNSTILE_SECRET_KEY=your-secret-key   (supabase dashboard only — NEVER commit)
# values with real credentials for local development.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com

# App Configuration
# Supabase (REQUIRED at build time — build aborts without these)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# PostHog Analytics (must match scripts/check-web-env.mjs OPTIONAL list)
EXPO_PUBLIC_APP_SCHEME=pulse

# ─── Bot Protection (Cloudflare Turnstile) ─────────────────────────────
POSTHOG_PROJECT_TOKEN=your-posthog-project-token
# Web-only: add a Turnstile site at https://dash.cloudflare.com → Turnstile

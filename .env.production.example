# ─── Cloudflare Pages production environment (template / placeholders) ─────
# Copy this file to .env (gitignored, never commit) and replace placeholders
# with real values. On Cloudflare Pages, set the same values in the dashboard
# at Settings > Variables and Secrets > Production AND Preview.
# Never commit live values.
# ─────────────────────────────────────────────────────────────────────────

# Supabase (REQUIRED at build time — build aborts without these)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Analytics (must match scripts/check-web-env.mjs OPTIONAL list)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_TOKEN=your-posthog-project-token
POSTHOG_HOST=https://eu.i.posthog.com

# App Configuration
EXPO_PUBLIC_APP_SCHEME=pulse

# ─── Bot Protection (Cloudflare Turnstile) ─────────────────────────────
# Web-only: add a Turnstile site at https://dash.cloudflare.com → Turnstile
EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# CLOUDFLARE_TURNSTILE_SECRET_KEY=your-secret-key   (supabase dashboard only — NEVER commit)
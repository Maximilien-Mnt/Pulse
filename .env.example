# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-project-key
POSTHOG_HOST=https://eu.posthog.com

# App Configuration
EXPO_PUBLIC_APP_SCHEME=pulse

# ─── Password Recovery (Supabase Auth) ─────────────────────────────
# The redirect URL for password recovery is built dynamically by
# lib/constants.ts → getRedirectUrl():
#   - Web:           <current-origin>/auth/reset-password
#   - Native (Expo): pulse://auth/reset-password
#
# You MUST register the following Redirect URLs in the Supabase Dashboard
# under Authentication → URL Configuration → Redirect URLs:
#
#   pulse://auth/reset-password
#   http://localhost:8081/auth/reset-password
#   https://your-production-domain.com/auth/reset-password
#
# No env var is needed — the scheme is read from EXPO_PUBLIC_APP_SCHEME above.
# ─────────────────────────────────────────────────────────────────────

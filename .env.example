# ─── Cloudflare Pages checklist (web deploy) ─────────────────────────
# `npm run build:web` runs scripts/check-web-env.mjs first: a build without
# the two EXPO_PUBLIC_* vars fails instead of shipping a blank page.
# Copy each value below into the dashboard (BOTH environments, then rebuild):
#   Cloudflare Pages > pulse > Settings > Variables and Secrets
#   > Production AND Preview > Save > Retry deployment.
# Never put live values in wrangler.toml (public repo; Pages ignores [vars]
# at build time anyway). Changing any var requires a rebuild (inlined).
# ─────────────────────────────────────────────────────────────────────

# Supabase (REQUIRED at build time — build aborts without these)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Analytics (must match scripts/check-web-env.mjs OPTIONAL list)
# Web export inlines EXPO_PUBLIC_* at build time; native reads app.config extra.
# Set BOTH so web + native stay in sync — POSTHOG_* feeds app.config extra.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_TOKEN=your-posthog-project-token
POSTHOG_HOST=https://eu.i.posthog.com

# App Configuration
EXPO_PUBLIC_APP_SCHEME=pulse

# ─── Bot Protection (Cloudflare Turnstile) ─────────────────────────────
# Web-only: add a Turnstile site at https://dash.cloudflare.com → Turnstile
#   EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY  (public, shipped to client)
#   CLOUDFLARE_TURNSTILE_SECRET_KEY            (server-only, set in Supabase
#                                               Edge Function env vars — NEVER
#                                               commit to git)
# Native clients skip Turnstile and rely on device fingerprint + edge rate limit.
EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# CLOUDFLARE_TURNSTILE_SECRET_KEY=your-secret-key   (supabase dashboard only)

# Signup edge-function rate limits (env vars read by the function):
#   SIGNUP_RATE_LIMIT_PER_IP    max signups per IP per window (default 5)
#   SIGNUP_RATE_LIMIT_PER_DEVICE max signups per device per window (default 3)
#   SIGNUP_RATE_LIMIT_WINDOW_SECS window length in seconds (default 3600)
# ───────────────────────────────────────────────────────────────────────

# ─── Password Recovery (Supabase Auth) ─────────────────────────────
# The redirect URL for password recovery is built dynamically by
# lib/constants.ts → getRedirectUrl():
#   - Web:           <current-origin>/auth/reset-password
#   - Native (Expo): pulse://auth/reset-password
#
# You MUST register the following Redirect URLs in the Supabase Dashboard
# under Authentication → URL Configuration → Redirect URLs:
#
#   pulse://auth/reset-password
#   http://localhost:8081/auth/reset-password
#   https://your-production-domain.com/auth/reset-password
#
# No env var is needed — the scheme is read from EXPO_PUBLIC_APP_SCHEME above.
# ─────────────────────────────────────────────────────────────────────
